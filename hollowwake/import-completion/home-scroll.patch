+// Original home-only scrolling. Native scrolling/anchors remain in control.
+// The Echo reference could not be inspected (Cloudflare challenge); no exact-match claim.
+function initializeHomeJourney() {
+  const journey = document.getElementById('home-journey');
+  if (!journey || location.pathname !== '/') return;
+  journey.hidden = false;
+  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
+  const chapters = Array.from(journey.querySelectorAll('.journey-chapter'));
+  const links = Array.from(journey.querySelectorAll('.journey-nav a'));
+  const fill = document.getElementById('reading-progress-fill');
+  let scheduled = false;
+  function update() {
+    scheduled = false;
+    const scrollable = Math.max(1, document.documentElement.scrollHeight - innerHeight);
+    fill.style.transform = `scaleX(${Math.min(1, Math.max(0, scrollY / scrollable))})`;
+    document.body.style.setProperty('--scene-y', reduced.matches ? '0px' : `${-Math.min(64, Math.max(0, scrollY * 0.025))}px`);
+    let active = null;
+    for (const chapter of chapters) if (chapter.getBoundingClientRect().top <= innerHeight * 0.55) active = chapter.id;
+    for (const link of links) {
+      if (link.hash === '#' + active) link.setAttribute('aria-current', 'location');
+      else link.removeAttribute('aria-current');
+    }
+  }
+  function schedule() { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } }
+  addEventListener('scroll', schedule, { passive: true });
+  addEventListener('resize', schedule, { passive: true });
+  reduced.addEventListener('change', schedule);
+  if (!reduced.matches && 'IntersectionObserver' in window) {
+    const observer = new IntersectionObserver(entries => {
+      for (const entry of entries) if (entry.isIntersecting) {
+        entry.target.classList.add('chapter-visible'); observer.unobserve(entry.target);
+      }
+    }, { threshold: 0.08 });
+    for (const chapter of chapters) { chapter.classList.add('chapter-motion'); observer.observe(chapter); }
+  }
+  schedule();
+}
+initializeHomeJourney();

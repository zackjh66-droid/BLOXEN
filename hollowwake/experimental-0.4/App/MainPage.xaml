<Page x:Class="Hollowwake.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#08090C" KeyDown="Page_KeyDown">
 <Page.Resources><SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF8A24"/><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF8A24"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF8A24"/><SolidColorBrush x:Key="ButtonBackground" Color="#FF8A24"/><Style TargetType="Button"><Setter Property="FontSize" Value="22"/><Setter Property="MinHeight" Value="64"/><Setter Property="MinWidth" Value="180"/><Setter Property="Padding" Value="24,12"/><Setter Property="Margin" Value="0,12,16,0"/><Setter Property="Background" Value="#F6F4FA"/><Setter Property="Foreground" Value="#101116"/><Setter Property="CornerRadius" Value="8"/><Setter Property="FocusVisualPrimaryBrush" Value="#FF8A24"/><Setter Property="FocusVisualSecondaryBrush" Value="#FF8A24"/><Setter Property="UseSystemFocusVisuals" Value="True"/></Style></Page.Resources>
 <Grid XYFocusKeyboardNavigation="Enabled">
  <Image x:Name="BackgroundImage" Source="Assets/Landmark.jpg" Stretch="UniformToFill" Opacity="1"/><Rectangle Fill="#55050910"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#66C4A1F5" Offset="0"/><GradientStop Color="#00C4A1F5" Offset="0.22"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <Grid Margin="72,48"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="HW" FontSize="38" FontWeight="Black" Foreground="#FF8A24" Margin="0,0,18,0"/><TextBlock Text="HOLLOWWAKE" FontSize="38" FontWeight="Black" FontStyle="Oblique" CharacterSpacing="60"/></StackPanel><TextBlock Text="UNOFFICIAL FAN PROJECT · CLIENT LOADER EXPERIMENT · UNVERIFIED ON XBOX" FontSize="14" Foreground="#E3D5FF" Margin="0,8,0,0"/></StackPanel>
   <ScrollViewer x:Name="MainScroller" AutomationProperties.AutomationId="MainScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
    <Grid Background="#E60B0D13" Padding="32" CornerRadius="16">
     <StackPanel x:Name="SplashPanel" HorizontalAlignment="Center"><TextBlock Text="Find your way back." FontSize="44" FontWeight="SemiBold" TextWrapping="Wrap"/><ProgressRing IsActive="True" Width="48" Height="48" Margin="0,30"/><TextBlock Text="Preparing the native client runtime…" FontSize="22" HorizontalAlignment="Center"/></StackPanel>
     <StackPanel x:Name="SetupPanel" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Connect to your account service" FontSize="36"/><TextBlock Text="Enter the real HTTPS address where you deployed the Hollowwake website and backend. There is no hosted service configured in this source build." FontSize="22" TextWrapping="Wrap" Margin="0,20"/><TextBox x:Name="OriginInput" Header="Backend HTTPS origin" PlaceholderText="Enter your deployed HTTPS origin" FontSize="22" InputScope="Url" MaxLength="250"/><Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click"/></StackPanel>
     <StackPanel x:Name="LinkPanel" Visibility="Collapsed" MaxWidth="1000" HorizontalAlignment="Left"><TextBlock Text="Link this experiment" FontSize="40"/><TextBlock Text="Open the website on your phone or computer, sign in to Hollowwake, then explicitly approve this device." FontSize="22" TextWrapping="Wrap" Margin="0,14,0,24"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CodeText" AutomationProperties.AutomationId="CodeText" Text="Requesting code…" FontSize="56" FontWeight="Bold" CharacterSpacing="200" Foreground="#E3D5FF"/><TextBlock x:Name="WebsiteText" FontSize="22" TextWrapping="Wrap" Margin="0,18"/><TextBlock x:Name="ExpiryText" FontSize="18"/><ProgressRing x:Name="PollingRing" IsActive="True" Width="28" Height="28" HorizontalAlignment="Left" Margin="0,18"/></StackPanel><Image Grid.Column="1" x:Name="QrImage" Width="260" Height="260" AutomationProperties.Name="Scan this QR code to open the device-linking website"/></Grid><StackPanel Orientation="Horizontal"><Button x:Name="RetryButton" AutomationProperties.AutomationId="RetryButton" Content="Retry" Click="Retry_Click"/><Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Content="Cancel (B)" Click="Cancel_Click"/></StackPanel></StackPanel>
     <StackPanel x:Name="LinkedPanel" Visibility="Collapsed" MaxWidth="950" HorizontalAlignment="Left"><TextBlock Text="Project account linked." FontSize="40"/><TextBlock x:Name="UsernameText" AutomationProperties.AutomationId="UsernameText" FontSize="30" Foreground="#E3D5FF" Margin="0,20"/><TextBlock Text="Imports the inspected 6.21 game archive and attempts native image mapping, TLS, import resolution and unwind registration. Unresolved APIs stop before guest entry. No working Fortnite lobby is claimed." FontSize="24" TextWrapping="Wrap"/><Border Background="#33283F" Padding="18" Margin="0,22"><TextBlock Text="Matches are not available yet" FontSize="24"/></Border><StackPanel Orientation="Vertical"><Button Content="Import 6.21 archive" Click="Import_Click"/><Button Content="Attempt client loading" Click="Launch_Click"/><Button Content="Show launch log" Click="Log_Click"/><Button x:Name="CheckButton" Content="Check connection" Click="Check_Click"/><Button x:Name="SignOutButton" AutomationProperties.AutomationId="SignOutButton" Content="Sign out" Click="SignOut_Click"/></StackPanel></StackPanel>
     <StackPanel x:Name="CancelledPanel" Visibility="Collapsed"><TextBlock Text="Linking cancelled." FontSize="36"/><Button x:Name="StartButton" AutomationProperties.AutomationId="StartButton" Content="Start again" Click="Retry_Click"/></StackPanel>
    </Grid>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,24,0,0"><TextBlock Text="Xbox help: Dev Home → highlight Hollowwake → View → View details → App type → Game (optional). Relaunch after changing. Resource allocation only; does not enable desktop APIs. Record your classification when testing." FontSize="14" Foreground="#D0CDD8" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock x:Name="StatusText" FontSize="19" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Not affiliated with or endorsed by Epic Games. Project-owned fallback art. Imported game splash is displayed only after local import; this is not game rendering. No Epic account required." FontSize="14" Foreground="#BBB0CC" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel>
  </Grid>
 </Grid>
</Page>

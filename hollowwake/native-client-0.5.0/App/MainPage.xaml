<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Hollowwake.MainPage" RequiresPointer="Never" Background="#08090C" KeyDown="Page_KeyDown" Foreground="White">
 <Page.Resources>
  <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF9B00"/><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF9B00"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF7800"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#090A0F"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="#090A0F"/>
  <Style TargetType="Button"><Setter Property="FontFamily" Value="/Assets/Anton-Regular.ttf#Anton"/><Setter Property="FontSize" Value="24"/><Setter Property="MinHeight" Value="40"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="18,4"/><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="FocusVisualPrimaryBrush" Value="#FF9B00"/><Setter Property="FocusVisualSecondaryBrush" Value="#FF9B00"/><Setter Property="UseSystemFocusVisuals" Value="True"/></Style>
 </Page.Resources>
 <Grid XYFocusKeyboardNavigation="Enabled"><SwapChainPanel x:Name="GameSurface"/><Grid x:Name="HostOverlay">
  <Image x:Name="BackgroundImage" Source="Assets/Landmark.jpg" Stretch="UniformToFill"/><Rectangle Fill="#45050713"/>
  <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#775B21A5" Offset="0"/><GradientStop Color="#005B21A5" Offset="0.19"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <Viewbox Stretch="Uniform"><Grid Width="1280" Height="720"><Grid Margin="64,36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12"><Image Source="Assets/HollowwakeMark.png" Width="110" Height="67"/><TextBlock Text="HOLLOWWAKE" FontFamily="/Assets/Anton-Regular.ttf#Anton" FontSize="38" CharacterSpacing="20" HorizontalAlignment="Center"><TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD42A" Offset="0"/><GradientStop Color="#FF6500" Offset="1"/></LinearGradientBrush></TextBlock.Foreground></TextBlock><TextBlock Text="UNOFFICIAL FAN PROJECT · EXPERIMENTAL CLIENT RUNTIME" FontSize="11" CharacterSpacing="80" HorizontalAlignment="Center" Foreground="#E0DCE9" Margin="0,4,0,0"/></StackPanel>
   <Grid x:Name="MainLayout" Grid.Row="1" VerticalAlignment="Center">
    <Grid MaxWidth="960" HorizontalAlignment="Stretch" Padding="12,6">
     <StackPanel x:Name="SplashPanel" HorizontalAlignment="Center"><ProgressRing IsActive="True" Width="40" Height="40" Foreground="#FF9B00" Margin="0,18"/><TextBlock Text="PREPARING THE CLIENT RUNTIME" FontFamily="/Assets/Anton-Regular.ttf#Anton" FontSize="25" HorizontalAlignment="Center"/></StackPanel>
     <StackPanel x:Name="SetupPanel" Visibility="Collapsed" MaxWidth="640"><TextBlock Text="CONNECT YOUR ACCOUNT SERVICE" FontFamily="/Assets/Anton-Regular.ttf#Anton" FontSize="30"/><TextBlock Text="Use the HTTPS address of your Hollowwake backend. Your existing account and device approval stay protected." FontSize="20" TextWrapping="Wrap" Margin="0,14"/><TextBox x:Name="OriginInput" Header="Backend HTTPS origin" FontSize="22" InputScope="Url" MaxLength="250"/><Button x:Name="ConnectButton" Content="CONNECT" Click="Connect_Click"/></StackPanel>
     <StackPanel x:Name="LinkPanel" Visibility="Collapsed"><TextBlock Text="LINK YOUR XBOX" FontFamily="/Assets/Anton-Regular.ttf#Anton" FontSize="32" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="224"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sign in on your phone, enter this code, then approve this device." FontSize="20" TextWrapping="Wrap" Margin="0,0,24,8"/><TextBlock x:Name="CodeText" AutomationProperties.AutomationId="CodeText" Text="Requesting code…" FontSize="48" FontWeight="Bold" CharacterSpacing="130" Foreground="#FFBC4A"/><TextBlock x:Name="WebsiteText" FontSize="20" TextWrapping="Wrap" Margin="0,8,24,4"/><TextBlock x:Name="ExpiryText" FontSize="16"/><ProgressRing x:Name="PollingRing" IsActive="True" Width="24" Height="24" Foreground="#FF9B00" HorizontalAlignment="Left" Margin="0,8"/></StackPanel><Border Grid.Column="1" Background="White" Padding="10" VerticalAlignment="Top"><Image x:Name="QrImage" Width="200" Height="200" AutomationProperties.Name="Scan to open the Hollowwake device-linking website"/></Border></Grid><StackPanel Orientation="Horizontal"><Button x:Name="RetryButton" AutomationProperties.AutomationId="RetryButton" Content="RETRY" Width="200" Click="Retry_Click"/><Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Content="CANCEL (B)" Width="220" Click="Cancel_Click"/></StackPanel></StackPanel>
     <StackPanel x:Name="LinkedPanel" Visibility="Collapsed" MaxWidth="560"><TextBlock x:Name="UsernameText" AutomationProperties.AutomationId="UsernameText" FontSize="18" Foreground="#FFE3BC" Margin="18,0,0,10"/><Button x:Name="LaunchButton" Content="LAUNCH NATIVE CLIENT" Click="Launch_Click" AutomationProperties.AutomationId="LaunchButton"/><StackPanel Orientation="Horizontal"><ProgressRing x:Name="ContentRing" Width="20" Height="20" Foreground="#FF9B00" Margin="18,4,10,4"/><TextBlock x:Name="ContentStatusText" Text="Game content downloads automatically after linking." FontSize="16" MaxWidth="460" TextTrimming="CharacterEllipsis" MaxHeight="24"/></StackPanel><ProgressBar AutomationProperties.Name="Game content download and verification progress" x:Name="ContentProgressBar" Minimum="0" Maximum="100" Value="0" Height="5" Margin="18,5,0,7" Foreground="#FF9B00"/><TextBlock x:Name="ContentBytesText" FontSize="14" TextWrapping="Wrap" MaxHeight="40" Margin="18,0,0,4" Text="Data: not audited yet"/><TextBlock x:Name="CodeStatusText" FontSize="14" MaxHeight="20" TextTrimming="CharacterEllipsis" Margin="18,0,0,5" Text="Client code: not audited yet"/><StackPanel Orientation="Horizontal"><Button x:Name="ImportButton" Width="350" FontSize="20" Content="DOWNLOAD / VERIFY CONTENT" Click="ContentRetry_Click" AutomationProperties.AutomationId="ImportButton"/><Button x:Name="PauseContentButton" Width="210" FontSize="20" Content="PAUSE (B)" Click="ContentPause_Click" IsEnabled="False"/></StackPanel><Button AutomationProperties.AutomationId="LogButton" Content="SHOW LAUNCH LOG" Click="Log_Click"/><Button x:Name="CheckButton" Content="CHECK CONNECTION" Click="Check_Click"/><Button x:Name="SignOutButton" AutomationProperties.AutomationId="SignOutButton" Content="SIGN OUT" Click="SignOut_Click"/><TextBlock Text="Matches are not available yet" FontSize="16" Margin="18,12,0,0" Foreground="#E3D2F5"/></StackPanel>
     <StackPanel x:Name="StartupFailurePanel" Visibility="Collapsed" MaxWidth="560"><TextBlock Text="LAUNCHER STARTUP STOPPED" FontFamily="/Assets/Anton-Regular.ttf#Anton" FontSize="32"/><TextBlock x:Name="StartupFailureText" AutomationProperties.AutomationId="StartupFailureText" FontSize="22" TextWrapping="Wrap" Margin="0,16"/><Button x:Name="StartupRetryButton" AutomationProperties.AutomationId="StartupRetryButton" Content="RETRY STARTUP" Click="StartupRetry_Click"/></StackPanel>
     <StackPanel x:Name="CancelledPanel" Visibility="Collapsed" MaxWidth="560"><TextBlock Text="LINKING CANCELLED" FontFamily="/Assets/Anton-Regular.ttf#Anton" FontSize="32"/><Button x:Name="StartButton" AutomationProperties.AutomationId="StartButton" Content="START AGAIN" Click="Retry_Click"/></StackPanel>
    </Grid>
   </Grid>
   <StackPanel Grid.Row="2" Margin="0,10,0,0" MaxWidth="1120"><TextBlock x:Name="StatusText" FontSize="17" MaxHeight="44" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="UNOFFICIAL CLIENT EXPERIMENT · ORIGINAL FORTNITE LOBBY NOT YET REACHED · MATCHES UNAVAILABLE" FontSize="11" Foreground="#E0DAEA" Margin="0,7,0,0"/><TextBlock Text="Portions of the materials used are trademarks and/or copyrighted works of Epic Games, Inc. All rights reserved by Epic. This material is not official and is not endorsed by Epic." FontSize="10" Foreground="#C7C0D5" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  </Grid>
 </Grid></Viewbox></Grid></Grid>
</Page>
